---
import { getCollection } from "astro:content";
import BaseHead from "../../components/BaseHead.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import ThoughtCard from "../../components/ThoughtCard.astro";
import AnalyticsScripts from "../../components/AnalyticsScripts.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../../consts";

const thoughts = (await getCollection("thoughts")).sort(
    (a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf(),
);

const pageTitle = "Thoughts";
const pageDescription = "Random thoughts, quick updates, and micro-posts";
---

<!doctype html>
<html lang="en">
    <head>
        <BaseHead
            title={`${pageTitle} | ${SITE_TITLE}`}
            description={pageDescription}
        />
    </head>
    <body
        class="bg-gradient-to-br from-slate-50 via-violet-50 to-fuchsia-50 dark:from-slate-900 dark:via-slate-800 dark:to-slate-900 min-h-screen flex flex-col"
    >
        <Header />
        <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 flex-1">
            <div class="mb-12">
                <h1
                    class="text-4xl sm:text-5xl font-bold text-slate-900 dark:text-white mb-4"
                >
                    💭 Thoughts
                </h1>
                <p class="text-lg text-slate-600 dark:text-slate-300">
                    Random thoughts, quick updates, and micro-posts
                </p>
            </div>

            {
                thoughts.length === 0 ? (
                    <div class="glass-card p-8 text-center">
                        <p class="text-slate-600 dark:text-slate-400">
                            No thoughts yet. Check back soon!
                        </p>
                    </div>
                ) : (
                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                        {thoughts.map((thought) => (
                            <ThoughtCard thought={thought} />
                        ))}
                    </div>
                )
            }
        </main>
        <Footer />
        <AnalyticsScripts />
    </body>
</html>

<style>
    .glass-card {
        background: rgba(255, 255, 255, 0.85);
        border: 1px solid rgba(255, 255, 255, 0.3);
        border-radius: 16px;
        box-shadow:
            0 10px 15px -3px rgba(0, 0, 0, 0.05),
            0 4px 6px -2px rgba(0, 0, 0, 0.02);
        transition:
            background-color 0.3s ease,
            border-color 0.3s ease;
    }

    :global(.dark) .glass-card {
        background: rgba(30, 41, 59, 0.85);
        border: 1px solid rgba(255, 255, 255, 0.15);
        box-shadow:
            0 20px 25px -5px rgba(0, 0, 0, 0.2),
            0 10px 10px -5px rgba(0, 0, 0, 0.1);
    }

    @media (min-width: 640px) {
        @supports (backdrop-filter: blur(12px)) or
            (-webkit-backdrop-filter: blur(12px)) {
            .glass-card {
                background: rgba(255, 255, 255, 0.25);
                backdrop-filter: blur(12px) saturate(110%);
                -webkit-backdrop-filter: blur(12px) saturate(110%);
            }

            :global(.dark) .glass-card {
                background: rgba(15, 23, 42, 0.3);
                border: 1px solid rgba(255, 255, 255, 0.2);
                box-shadow:
                    0 25px 50px -12px rgba(0, 0, 0, 0.5),
                    inset 0 1px 1px rgba(255, 255, 255, 0.1);
            }
        }
    }
</style>
