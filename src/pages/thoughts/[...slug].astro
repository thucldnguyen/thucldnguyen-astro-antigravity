---
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";
import BaseHead from "../../components/BaseHead.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import FormattedDate from "../../components/FormattedDate.astro";
import ReactionButtons from "../../components/ReactionButtons";
import CommentSection from "../../components/CommentSection";
import CommentForm from "../../components/CommentForm";
import { SITE_TITLE } from "../../consts";

export async function getStaticPaths() {
    const thoughts = await getCollection("thoughts");
    return thoughts.map((thought) => ({
        params: { slug: thought.id },
        props: { thought },
    }));
}

interface Props {
    thought: CollectionEntry<"thoughts">;
}

const { thought } = Astro.props;
const { title, content, image, publishedAt } = thought.data;

// Auto-detect links in content
const contentWithLinks = content.replace(
    /(https?:\/\/[^\s]+)/g,
    '<a href="$1" target="_blank" rel="noopener noreferrer" class="text-violet-600 dark:text-violet-400 hover:underline">$1</a>',
);

const pageTitle =
    title || content.substring(0, 60) + (content.length > 60 ? "..." : "");
const pageDescription = content.substring(0, 160);
---

<!doctype html>
<html lang="en">
    <head>
        <BaseHead
            title={`${pageTitle} | ${SITE_TITLE}`}
            description={pageDescription}
            image={image}
        />
    </head>
    <body
        class="bg-gradient-to-br from-slate-50 via-violet-50 to-fuchsia-50 dark:from-slate-900 dark:via-slate-800 dark:to-slate-900 min-h-screen"
    >
        <Header />
        <main class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
            <article class="thought-detail glass-card">
                <div class="mb-6">
                    <a
                        href="/thoughts"
                        class="inline-flex items-center gap-2 text-sm text-slate-600 dark:text-slate-400 hover:text-violet-600 dark:hover:text-violet-400 transition-colors"
                    >
                        ← Back to Thoughts
                    </a>
                </div>

                <div class="thought-content mb-6">
                    <p
                        class="text-slate-800 dark:text-slate-200 text-xl leading-relaxed whitespace-pre-wrap"
                        set:html={contentWithLinks}
                    />
                </div>

                {
                    image && (
                        <div class="thought-image mb-6">
                            <img
                                src={image}
                                alt=""
                                class="rounded-lg w-full object-cover"
                                loading="eager"
                            />
                        </div>
                    )
                }

                <div
                    class="thought-meta flex items-center justify-between text-sm text-slate-500 dark:text-slate-400 pb-6 border-b border-slate-200 dark:border-slate-700"
                >
                    <FormattedDate date={publishedAt} />
                </div>

                <div class="mt-6">
                    <ReactionButtons client:load thoughtId={thought.id} />
                </div>

                <CommentSection client:load thoughtId={thought.id} />
            </article>

            <!-- Comment Form - Separate card outside article -->
            <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 pb-12">
                <CommentForm
                    client:load
                    thoughtId={thought.id}
                    onCommentAdded={() => window.location.reload()}
                />
            </div>
        </main>

        <Footer />
    </body>
</html>

<style>
    .thought-detail {
        background: rgba(255, 255, 255, 0.85);
        border: 1px solid rgba(255, 255, 255, 0.3);
        border-radius: 16px;
        box-shadow:
            0 10px 15px -3px rgba(0, 0, 0, 0.05),
            0 4px 6px -2px rgba(0, 0, 0, 0.02);
        padding: 2rem;
        transition:
            background-color 0.3s ease,
            border-color 0.3s ease;
    }

    :global(.dark) .thought-detail {
        background: rgba(30, 41, 59, 0.85);
        border: 1px solid rgba(255, 255, 255, 0.15);
        box-shadow:
            0 20px 25px -5px rgba(0, 0, 0, 0.2),
            0 10px 10px -5px rgba(0, 0, 0, 0.1);
    }

    @media (min-width: 640px) {
        .thought-detail {
            padding: 3rem;
        }

        @supports (backdrop-filter: blur(12px)) or
            (-webkit-backdrop-filter: blur(12px)) {
            .thought-detail {
                background: rgba(255, 255, 255, 0.25);
                backdrop-filter: blur(12px) saturate(110%);
                -webkit-backdrop-filter: blur(12px) saturate(110%);
            }

            :global(.dark) .thought-detail {
                background: rgba(15, 23, 42, 0.3);
                border: 1px solid rgba(255, 255, 255, 0.2);
                box-shadow:
                    0 25px 50px -12px rgba(0, 0, 0, 0.5),
                    inset 0 1px 1px rgba(255, 255, 255, 0.1);
            }
        }
    }

    .thought-content {
        word-wrap: break-word;
        overflow-wrap: break-word;
    }
</style>
