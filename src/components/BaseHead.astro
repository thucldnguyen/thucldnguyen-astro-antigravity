---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import "../styles/global.css";
import type { ImageMetadata } from "astro";
import { ClientRouter } from "astro:transitions";
import { SITE_TITLE } from "../consts";

import favicon from "../assets/favicon.png";
import newThumbnail from "../assets/new-thumbnail.jpg";

interface Props {
	title: string;
	description: string;
	image?: ImageMetadata | string;
	preloadImage?: boolean;
	ogType?: string;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const {
	title,
	description,
	image = newThumbnail,
	preloadImage = true,
	ogType = "website",
} = Astro.props;
---

<!-- Analytics scripts moved to AnalyticsScripts.astro (bottom of body) for better performance -->

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/png" href={favicon.src} />
<link rel="sitemap" href="/sitemap-index.xml" />
<link
	rel="alternate"
	type="text/plain"
	title="LLM-friendly content"
	href="/llms.txt"
/>
<link
	rel="alternate"
	type="application/rss+xml"
	title={SITE_TITLE}
	href={new URL("rss.xml", Astro.site)}
/>
<meta name="generator" content={Astro.generator} />

<!-- Fonts: self-hosted via @fontsource in global.css (no external requests) -->

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Preload LCP image (hero/OG) so the browser fetches it earlier -->
{
	preloadImage && image && (
		<link
			rel="preload"
			as="image"
			href={
				typeof image === "string" ? image : (image as ImageMetadata).src
			}
		/>
	)
}

<ClientRouter />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />
<meta
	name="google-site-verification"
	content="Ktnkc0KXKUQoo8PpEAU0Zyrub6dCY01Us79CMkiswzA"
/>

<script is:inline>
	document.documentElement.classList.remove("no-js");
	function applyTheme() {
		if (
			localStorage.getItem("color-theme") === "dark" ||
			!("color-theme" in localStorage)
		) {
			document.documentElement.classList.add("dark");
		} else {
			document.documentElement.classList.remove("dark");
		}
	}

	applyTheme();
	document.addEventListener("astro:after-swap", applyTheme);
</script>

<script is:inline>
	// Optimize view transitions with immediate feedback
	document.addEventListener("astro:before-preparation", (event) => {
		document.documentElement.dataset.isNavigating = "true";
	});

	document.addEventListener("astro:after-swap", () => {
		document.documentElement.dataset.isNavigating = "false";
		// Re-apply theme if needed (already handled by other listener)
	});

	document.addEventListener("astro:page-load", () => {
		document.documentElement.dataset.isNavigating = "false";

		// Trigger any lazy-loaded content after navigation
		if (typeof window !== "undefined" && "requestIdleCallback" in window) {
			requestIdleCallback(() => {
				// Progressive enhancement: load non-critical resources
				const lazyImages = document.querySelectorAll(
					'img[loading="lazy"]',
				);
				lazyImages.forEach((img) => {
					if (img instanceof HTMLImageElement && img.dataset.src) {
						img.src = img.dataset.src;
					}
				});
			});
		}
	});
</script>

<script is:inline>
	// One-time cleanup of old Gatsby service worker and caches.
	// Runs once per browser, then sets a localStorage flag to skip future visits.
	// TEMPORARY: remove after 2026-04-01.
	if (!localStorage.getItem("sw-cleaned")) {
		if ("serviceWorker" in navigator) {
			navigator.serviceWorker.getRegistrations().then(function (regs) {
				for (var i = 0; i < regs.length; i++) {
					regs[i].unregister();
				}
			});
		}
		if ("caches" in window) {
			caches.keys().then(function (names) {
				for (var i = 0; i < names.length; i++) {
					caches.delete(names[i]);
				}
			});
		}
		localStorage.setItem("sw-cleaned", "1");
	}
</script>

<!-- Open Graph / Facebook -->
<meta property="og:type" content={ogType} />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta
	property="og:image"
	content={new URL(
		(typeof image === "string" ? image : image?.src) || newThumbnail.src,
		Astro.site,
	)}
/>
<meta property="og:site_name" content={SITE_TITLE} />

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={Astro.url} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta
	property="twitter:image"
	content={new URL(
		(typeof image === "string" ? image : image?.src) || newThumbnail.src,
		Astro.site,
	)}
/>

<!-- Google Analytics moved to AnalyticsScripts.astro for better performance and view transitions support -->
